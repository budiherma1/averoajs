<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify your email address</title>
</head>
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;">
    <tr>
      <td style="padding:32px;">
        <h1 style="margin:0 0 16px;font-size:20px;">Verify your email address</h1>
        <p style="margin:0 0 16px;">Hello {{ name }},</p>
        <p style="margin:0 0 24px;">Thanks for signing up for {{ appName }}. Please confirm your email address by clicking the button below.</p>
        <p style="margin:0 0 24px;">
          <a href="{{ url }}" style="display:inline-block;padding:12px 20px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:6px;">Verify email address</a>
        </p>
        <p style="margin:0 0 16px;font-size:13px;color:#6b7280;">The link expires in {{ minutes }} minutes. If you did not create an account, no further action is required.</p>
        <p style="margin:0;font-size:13px;color:#6b7280;word-break:break-all;">If the button does not work, copy this address into your browser: {{ url }}</p>
      </td>
    </tr>
  </table>
</body>
</html>
