NODE_ENV=development
APP_HOST=http://localhost
APP_PORT=8888
# Allowed cross-origin front ends, comma separated: exact origins (https://app.example.com),
# subdomain wildcards (https://*.example.com) or * (every origin, without credentials).
# Empty: NODE_ENV=development/test allows every origin with credentials (cookies); any other
# NODE_ENV allows every origin WITHOUT credentials. Same-origin requests are always allowed.
# Origins that are not listed get 403, so list your real front ends before deploying.
CORS_WHITELIST=

# Required. Secret used to sign JWTs; the app refuses to start without it.
# Generate one with `npm run generate:token` (or `openssl rand -hex 64`)
TOKEN_SECRET=
# Access token (JWT) lifetime: seconds (900) or a number with a unit s, m, h, d, w (15m, 2h).
# Keep it short: logout, logout-all and password resets end sessions, and access tokens are also
# checked against the session on every request. TOKEN_EXPIRES_IN (older name) is still read when
# JWT_ACCESS_TTL is not set.
JWT_ACCESS_TTL=15m
# Refresh token lifetime; every POST /api/auth/refresh rotates the token and restarts it
JWT_REFRESH_TTL=30d
# Password reset links: lifetime, and the minimum time between two links for one account
PASSWORD_RESET_TTL=60m
PASSWORD_RESET_THROTTLE=60s
# Email verification links: lifetime, and the minimum time between two resends
EMAIL_VERIFICATION_TTL=24h
EMAIL_VERIFICATION_THROTTLE=60s
# Public URL of this API (default APP_HOST:APP_PORT) and of the front end that opens the links in
# the verification and reset emails (/verify-email?token=..., /reset-password?token=...; default APP_URL)
APP_URL=
FRONTEND_URL=
# Rate limits of register / forgot-password (every request) and refresh / reset-password /
# verify-email (failed requests only), per client IP and endpoint, in memory of each process
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_FAILED_MAX=20
# Secret used to sign the session cookie; required when NODE_ENV=production.
# Generate it the same way as TOKEN_SECRET. A comma separated list rotates secrets
# (the first one signs, all of them verify).
SESSION_SECRET=
# Session store: memory (default; one process only, warns outside development/test) | redis
# redis needs `npm install redis connect-redis` and REDIS_URL. Outside development/test the app
# refuses to start when Redis is unreachable.
SESSION_STORE=memory
# Redis key prefix for sessions and their lifetime in seconds when the cookie has no maxAge
SESSION_REDIS_PREFIX=sess:
SESSION_TTL=86400
# Shared by the session and rate-limit stores, e.g. redis://:password@127.0.0.1:6379/0 (rediss:// for TLS)
REDIS_URL=
# Max time (ms) to wait for Redis at startup
REDIS_CONNECT_TIMEOUT=5000

# Global rate limit for /api: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS per client IP.
# Over the limit: 429 { status: false, message, code: 'ERATELIMIT' }
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Counter store for every rate limiter: memory (per process) | redis (shared by every instance;
# needs `npm install redis rate-limit-redis`). Empty: redis when SESSION_STORE=redis, else memory
RATE_LIMIT_STORE=
RATE_LIMIT_REDIS_PREFIX=rl:
# Login brute-force protection (POST /api/auth/login, failed attempts only): per IP + email,
# per IP (any email), and the window in ms (900000 = 15 minutes)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_IP_MAX=50
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# CSRF protection for web (non /api) routes: forms send a hidden `_csrf` field,
# AJAX / multipart requests send the `x-csrf-token` header
CSRF_ENABLED=true
# Max size of JSON / urlencoded request bodies
BODY_LIMIT=1mb
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
# Where logs go: stdout | file | both. Empty: storages/logs files, plus the console unless
# NODE_ENV=production. Containers: stdout (nothing is written to disk).
LOG_CHANNEL=
# Console format of the application log: json | pretty. Empty: pretty for development/test,
# json otherwise. Files are always JSON lines.
LOG_FORMAT=
# HTTP access log format: combined | json | dev (dev: stdout only). Empty: combined in files;
# on stdout json, or dev when LOG_FORMAT is pretty / NODE_ENV is development or test.
ACCESS_LOG_FORMAT=
# Extra keys to redact in logged objects (comma separated); authorization, cookie, password,
# secret, token, api keys... are always redacted
LOG_REDACT=
# Max upload size in bytes (UploadImageMiddleware); 2097152 = 2 MB
UPLOAD_MAX_FILE_SIZE=2097152
# Where UploadProvider stores files: local (storages/upload, served at /upload) | s3
UPLOAD_DRIVER=local
# UPLOAD_DRIVER=s3: AWS S3 or an S3-compatible service through @aws-sdk/client-s3 (an optionalDependency,
# installed unless npm runs with --omit=optional)
S3_BUCKET=
S3_REGION=us-east-1
# S3-compatible services only, e.g. http://localhost:9000 (MinIO, which also needs S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Static credentials (set both, or neither to use the AWS default credential chain / IAM role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Base URL for UploadProvider.url(), e.g. a CDN; default: the bucket's endpoint URL
S3_PUBLIC_URL=
# Set when running behind a reverse proxy (e.g. 1, true, loopback). It also decides the client IP
# the rate limiters see: behind a proxy set it, without one leave it false (else clients can spoof
# X-Forwarded-For)
TRUST_PROXY=false
# OpenAPI document at GET /api/openapi.json and Swagger UI at GET /api/docs.
# Empty: on for NODE_ENV=development/test, off otherwise. OPENAPI_UI=false keeps only the JSON.
OPENAPI_ENABLED=
OPENAPI_UI=true
# Reuse the incoming X-Request-Id header (when valid: 1-128 chars of A-Z a-z 0-9 - _ . : + = / @).
# Only with TRUST_REQUEST_ID=true (when your proxy sets or overwrites the header); otherwise a new id.
TRUST_REQUEST_ID=
# Header used for the request id
REQUEST_ID_HEADER=X-Request-Id
# Liveness / readiness probe paths (false or off disables one)
HEALTH_PATH=/health
READY_PATH=/ready
# Per-check timeout of the readiness probe (ms)
READY_TIMEOUT=2000
# Built-in readiness checks: database, queue (RabbitMQ), comma separated; none for none
READY_CHECKS=database
# On SIGTERM / SIGINT: time (ms) /ready answers 503 before the server closes, so load
# balancers stop sending traffic (e.g. 5000 on Kubernetes); 0 closes right away
SHUTDOWN_DELAY=0
# Max time (ms) for a graceful shutdown on SIGTERM / SIGINT (counted after SHUTDOWN_DELAY)
SHUTDOWN_TIMEOUT=10000
# Application root, only needed when the process is not started from the project folder
# AVEROA_ROOT=/path/to/your/app

# mysql2 (default) | pg | better-sqlite3 | sqlite3
# for sqlite clients DB_NAME is the database file (default :memory:)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
# mysql2 only: time zone of the connection, Z (default, UTC) | an offset such as +07:00 | local
# (local = the Node.js time zone for JS Dates and the server default for CURRENT_TIMESTAMP)
DB_TIMEZONE=Z

RABBITMQ_SERVER=amqp://localhost
# queue used by Mail...queue(), EmailSubscriberJob and `npm run worker:mail`
MAIL_QUEUE=mail
# default queue of jobs (app/Jobs) that set no `static queue`; failed jobs are kept in `<queue>.failed`
JOBS_QUEUE=jobs
# `npm run worker:jobs`: comma separated queues to consume (empty: the queues of the jobs in app/Jobs)
JOBS_WORKER_QUEUES=
# `npm run worker:jobs`: jobs run at the same time per queue
JOBS_CONCURRENCY=1
# `npm run schedule:run`: default IANA time zone of app/Console/Kernel.js (empty: the process time zone)
SCHEDULE_TIMEZONE=

# SMTP is the only mail transport (nodemailer)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# ssl (implicit TLS, port 465) | tls (STARTTLS) | empty
MAIL_ENCRYPTION=
# true | false: overrides MAIL_ENCRYPTION (true = implicit TLS)
MAIL_SECURE=
# Sender of the app's emails: verification, password reset and SendWelcomeEmailJob
# (default "AveroaJS <no-reply@localhost>"); MAIL_FROM_NAME is also the application name in them
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AveroaJS

# Fetch utility (config/fetch.js): base URL for relative URLs, timeout in ms (default 10000, 0 = none)
FETCH_BASE_URL=
FETCH_TIMEOUT=10000

# Docker Compose (compose.yaml) only. The app container gets the service host names
# (mysql, rabbitmq, redis, minio, mailpit) automatically; DB_USER / DB_PASS / DB_NAME
# above also create the MySQL user and database (default averoa / averoa / averoa).
# DB_ROOT_PASS=root
# RABBITMQ_USER=averoa
# RABBITMQ_PASS=averoa
# MINIO_ROOT_USER=averoa
# MINIO_ROOT_PASSWORD=averoa-secret
# Host ports (bound to 127.0.0.1); change one when it is already in use
# FORWARD_APP_PORT=8888
# FORWARD_DB_PORT=3306
# FORWARD_RABBITMQ_PORT=5672
# FORWARD_RABBITMQ_DASHBOARD_PORT=15672
# FORWARD_REDIS_PORT=6379
# FORWARD_MINIO_PORT=9000
# FORWARD_MINIO_CONSOLE_PORT=9001
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
