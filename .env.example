NODE_ENV=development
APP_HOST=http://localhost
APP_PORT=8888
# Allowed cross-origin front ends, comma separated: exact origins (https://app.example.com),
# subdomain wildcards (https://*.example.com) or * (every origin, without credentials).
# Empty: NODE_ENV=development/test allows every origin with credentials (cookies); any other
# NODE_ENV allows every origin WITHOUT credentials. Same-origin requests are always allowed.
# Origins that are not listed get 403, so list your real front ends before deploying.
CORS_WHITELIST=

# Required. Secret used to sign JWTs; the app refuses to start without it.
# Generate one with `npm run generate:token` (or `openssl rand -hex 64`)
TOKEN_SECRET=
# JWT lifetime (jsonwebtoken format: 60, "2h", "7d")
TOKEN_EXPIRES_IN=1h
# Secret used to sign the session cookie; required when NODE_ENV=production.
# Generate it the same way as TOKEN_SECRET. A comma separated list rotates secrets
# (the first one signs, all of them verify).
SESSION_SECRET=
# CSRF protection for web (non /api) routes: forms send a hidden `_csrf` field,
# AJAX / multipart requests send the `x-csrf-token` header
CSRF_ENABLED=true
# Max size of JSON / urlencoded request bodies
BODY_LIMIT=1mb
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
# Max upload size in bytes (UploadImageMiddleware); 2097152 = 2 MB
UPLOAD_MAX_FILE_SIZE=2097152
# Where UploadProvider stores files: local (storages/upload, served at /upload) | s3
UPLOAD_DRIVER=local
# UPLOAD_DRIVER=s3: AWS S3 or an S3-compatible service through @aws-sdk/client-s3 (an optionalDependency,
# installed unless npm runs with --omit=optional)
S3_BUCKET=
S3_REGION=us-east-1
# S3-compatible services only, e.g. http://localhost:9000 (MinIO, which also needs S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Static credentials (set both, or neither to use the AWS default credential chain / IAM role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Base URL for UploadProvider.url(), e.g. a CDN; default: the bucket's endpoint URL
S3_PUBLIC_URL=
# Set when running behind a reverse proxy (e.g. 1, true, loopback)
TRUST_PROXY=false
# Max time (ms) for a graceful shutdown on SIGTERM / SIGINT
SHUTDOWN_TIMEOUT=10000
# Application root, only needed when the process is not started from the project folder
# AVEROA_ROOT=/path/to/your/app

# mysql2 (default) | pg | better-sqlite3 | sqlite3
# for sqlite clients DB_NAME is the database file (default :memory:)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

RABBITMQ_SERVER=amqp://localhost
# queue used by Mail...queue(), EmailSubscriberJob and `npm run worker:mail`
MAIL_QUEUE=mail

# SMTP is the only mail transport (nodemailer)
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# ssl (implicit TLS, port 465) | tls (STARTTLS) | empty
MAIL_ENCRYPTION=
# true | false: overrides MAIL_ENCRYPTION (true = implicit TLS)
MAIL_SECURE=

# Fetch utility (config/fetch.js): base URL for relative URLs, timeout in ms (default 10000, 0 = none)
FETCH_BASE_URL=
FETCH_TIMEOUT=10000
