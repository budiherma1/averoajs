{
  "name": "averoajs",
  "version": "2.1.0",
  "description": "'laravel like' boiler plate for express",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "imports": {
    "#models": "./app/Models/index.js",
    "#providers": "./app/Providers/index.js",
    "#repositories": "./app/Repositories/index.js",
    "#helpers": "./app/Helpers/index.js",
    "#jobs": "./app/Jobs/index.js",
    "#strategies": "./app/Strategies/index.js",
    "#app/*": "./app/*"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker:mail": "node workers/mail.js",
    "worker:jobs": "node workers/jobs.js",
    "schedule:run": "node workers/scheduler.js",
    "queue:retry": "node workers/retry-failed-jobs.js",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "link:local": "node scripts/link-local.mjs",
    "generate:token": "node app/Jobs/GenerateAppTokenJob.js",
    "migrate:make": "knex migrate:make --knexfile node_modules/@averoa/core/knexfile.js --cwd .",
    "seed:make": "knex seed:make --knexfile node_modules/@averoa/core/knexfile.js --cwd .",
    "migrate:up": "knex migrate:latest --knexfile node_modules/@averoa/core/knexfile.js --cwd .",
    "migrate:down": "knex migrate:rollback --knexfile node_modules/@averoa/core/knexfile.js --cwd .",
    "migrate:list": "knex migrate:list --knexfile node_modules/@averoa/core/knexfile.js --cwd .",
    "seed:run": "knex seed:run --knexfile node_modules/@averoa/core/knexfile.js --cwd .",
    "lint:fix": "eslint . --fix"
  },
  "author": {
    "name": "Budi Hermawan",
    "email": "budianonym@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budiherma1/averoajs.git"
  },
  "dependencies": {
    "@averoa/core": "^2.0.1",
    "@averoa/routes": "^3.0.1",
    "@averoa/utilities": "^2.0.2",
    "croner": "^10.0.1",
    "dotenv": "^16.6.1",
    "edge.js": "^5.5.1",
    "express": "^5.1.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "objection": "^3.1.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "better-sqlite3": "^12.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "nodemailer": "^10.3.1",
    "nodemon": "^3.1.10"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
