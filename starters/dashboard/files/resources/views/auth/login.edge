@component('components/layout', { title: 'Sign in', user: null, csrfToken })
  <div class="card auth-card shadow-sm">
    <div class="card-body p-4">
      <h1 class="h4 mb-1"><i class="bi bi-grid-fill text-primary"></i> Dashboard</h1>
      <p class="text-muted mb-4">Sign in with your account.</p>
      @if(error)
        <div class="alert alert-danger py-2" role="alert">{{ error }}</div>
      @end
      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="mb-3">
          <label class="form-label" for="email">Email</label>
          <input class="form-control" id="email" name="email" type="email" value="{{ email }}" autocomplete="username" required autofocus>
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Password</label>
          <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary w-100" type="submit">Sign in</button>
      </form>
    </div>
  </div>
@end
